<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atlas.Api</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>atlas-api-9f2b3c7e-6d4a-4b1e-9a0f-1c2d3e4f5a6b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Application\Atlas.Application.csproj" />
    <ProjectReference Include="..\Atlas.Infrastructure\Atlas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.OpenApi generates the /openapi/v1.json document
      (built into the ASP.NET Core stack, no third-party dependency). Only the
      UI sub-package of Swashbuckle is referenced — not the full
      Swashbuckle.AspNetCore meta-package — specifically to avoid pulling in
      its SwaggerGen/Microsoft.OpenApi.Models dependency chain, whose types
      moved namespace in the Microsoft.OpenApi 2.x line and broke a manually
      constructed OpenApiInfo here. SwaggerUI itself just needs a JSON URL to
      point at, so it has no such dependency.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />

    <!-- JWT bearer authentication for Del 5. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!--
      Program.cs's Key Vault block (pulled forward from Del 20 into Del 8) calls
      Configuration.AddAzureKeyVault(...), which is an extension method from this
      package, and constructs a DefaultAzureCredential from Azure.Identity to
      authenticate to it via the App Service's managed identity. Both were added
      to the real project with `dotnet add package` back in Del 8; recorded here
      explicitly now because this file is the source of truth for what a fresh
      `dotnet restore` needs — a csproj missing a package that Program.cs actually
      uses would only surface as a confusing build error on a clean machine, not
      here where the packages were already restored once.
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />

    <!--
      The EF Core CLI tools (`dotnet ef migrations add`, `dotnet ef database
      update`) load their design-time services from the *startup* project's
      dependency graph, not just the project that actually owns the
      DbContext — so Atlas.Api needs its own reference to
      Microsoft.EntityFrameworkCore.Design even though Atlas.Infrastructure
      already has one. PrivateAssets="all" keeps it out of the published
      output; it's a build/tooling-only dependency.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      Del 14: structured logging. Serilog.AspNetCore is the meta-package that
      brings in Serilog itself, the ASP.NET Core hosting integration
      (UseSerilog, UseSerilogRequestLogging) and a console sink — everything
      needed for the "replace the default logging providers, keep every
      existing ILogger<T> call site unchanged" story in Program.cs.
      Serilog.Settings.Configuration is what makes ReadFrom.Configuration(...)
      resolve (NOT bundled into Serilog.AspNetCore, unlike the console sink —
      confirmed by checking its actual dependency list rather than assuming).
      Serilog.Sinks.ApplicationInsights (+ Microsoft.ApplicationInsights,
      referenced directly since Program.cs constructs a TelemetryConfiguration
      itself) is the second sink, wired up only when
      ApplicationInsights:ConnectionString is actually set — see Program.cs.

      Microsoft.ApplicationInsights is pinned to 2.23.0, not whatever the
      newest 3.x release is, because Serilog.Sinks.ApplicationInsights 5.0.1
      itself declares a dependency constraint of ">= 2.23.0 && < 3.0.0" — an
      initial pin at 3.1.2 built fine but produced a real NU1608 warning
      ("resolved outside of dependency constraint") on Peter's machine,
      which is NuGet correctly flagging that the sink has never been tested
      against the 3.x line and its behavior there is unverified, not a
      cosmetic warning to silence. 2.23.0 is the newest version that actually
      satisfies the sink's own declared range.
    -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
  </ItemGroup>

</Project>
