<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atlas.Infrastructure</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Application\Atlas.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />

    <!-- JWT issuance for Del 5 (local auth). Already present transitively via
         Microsoft.Data.SqlClient's Azure AD support, referenced directly here
         since Atlas.Infrastructure calls its types explicitly. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />

    <!--
      Blob Storage for ticket attachments (Del 10) — see AzureBlobStorageService
      and the "Blob Storage" block in DependencyInjection.AddInfrastructure.
      Azure.Identity is already referenced by Atlas.Api for Key Vault's
      DefaultAzureCredential (Del 8); it's needed here too, directly, because
      the same DefaultAzureCredential-against-a-managed-identity pattern
      authenticates this project's BlobContainerClient to Azure in production.
    -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />

    <!--
      Explicit override for NU1903 (CVE-2026-50648, GHSA-23rf-6693-g89p): one of
      the packages above pulls in System.Security.Cryptography.Xml 9.0.0
      transitively, which is below the patched floor for both the 9.x line
      (9.0.18) and the 10.x line (10.0.10). Pinning it directly to a patched
      10.x version resolves the warning regardless of which dependency's
      minimum version eventually catches up on its own — same approach used
      for the Microsoft.OpenApi NU1903 warning during Del 1.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
