<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atlas.Worker</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Atlas.Application for IOverdueTicketNotificationService, Atlas.Infrastructure
      for AddPersistence and AddMessaging (Del 11 / Del 12 — see DependencyInjection.cs
      for why this worker calls those two pieces directly rather than the full
      AddInfrastructure() that Atlas.Api uses: it never touches Blob Storage or
      issues a JWT, so it has no reason to require that configuration too).
    -->
    <ProjectReference Include="..\Atlas.Application\Atlas.Application.csproj" />
    <ProjectReference Include="..\Atlas.Infrastructure\Atlas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!--
      Already a transitive dependency via the Atlas.Infrastructure
      ProjectReference above (which brings in AddMessaging's ServiceBusClient
      registration), but referenced directly here too because
      TicketAssignedConsumer.cs uses Azure.Messaging.ServiceBus types
      (ServiceBusProcessor, ProcessMessageEventArgs, ...) directly, the same
      "reference what you use directly" rule Atlas.Infrastructure's own
      csproj already follows for Azure.Identity.
    -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
  </ItemGroup>

</Project>
