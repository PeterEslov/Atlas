{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information"
    }
  },
  "ConnectionStrings": {
    "AtlasDb": "Server=(localdb)\\mssqllocaldb;Database=AtlasDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "OverdueTicketWorker": {
    "PollingIntervalMinutes": 5
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "nspl-sb-core-dev-sc.servicebus.windows.net",
    "ExcludeManagedIdentityCredential": true
  }
}
